<?xml version="1.0" encoding="utf-8"?>
<!--
  adaptive icon 的前景层：一个居中的「+」。

  为什么是「+」：模块做的事是「给澎湃 OS 补上它没做/做坏的功能」，一个加号最直白。
  形状全部落在 108 画布的中心 72×72 安全区内（18..90），外面那圈留给各家启动器的
  mask 裁切与视差位移 —— 画到边上会被裁掉一块。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 横杠：48×12，圆角 6 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,48 h36 a6,6 0 0 1 6,6 a6,6 0 0 1 -6,6 h-36 a6,6 0 0 1 -6,-6 a6,6 0 0 1 6,-6 z" />
    <!-- 竖杠：12×48，圆角 6 -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M48,36 a6,6 0 0 1 6,-6 a6,6 0 0 1 6,6 v36 a6,6 0 0 1 -6,6 a6,6 0 0 1 -6,-6 z" />
</vector>
